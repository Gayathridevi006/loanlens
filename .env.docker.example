# Copy to .env before running Docker Compose. Values below are for local use only.
POSTGRES_DB=loanlens
POSTGRES_USER=loanlens
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_REQUIRED=false
AUTH_BOOTSTRAP_SECRET=

LOANLENS_PORT=3000
LOANLENS_API_PORT=8000
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
AUDIT_RETENTION_DAYS=2555
JOB_RETENTION_DAYS=30

# Optional external adapters
OIDC_ISSUER=
OIDC_CLIENT_ID=
CREDIT_BUREAU_URL=
CREDIT_BUREAU_TOKEN=
NARRATIVE_LLM_URL=
NARRATIVE_LLM_TOKEN=
